  ],
  "props": ["Tığ saç tokası", "Kadın çantası", "Dövüş kıyafetleri (şort/tişört)", "Küçük ilaç kutusu / hap", "Kırık ayna ve makyaj malzemeleri"],
  "set_dressing": "Aynalar, lavabolar, tuvalet kabinleri, kan efektleri",
  "wardrobe_makeup": "Özgü: Çiçekli elbise -> Dövüş şortu ve tişörtü, kan efektleri. Dövmeli: Kovboy botları, yoğun vücut dövmeleri, kan efektleri.",
  "estimated_screen_time_min": 4.5,
