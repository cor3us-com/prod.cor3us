# Ortam değişkenleri şablonu — Cor3us Ready
# Bu dosyayı .env olarak kopyalayıp doldur, asla commit etme!

# Web sunucu portu (local için 3000, cloud için 8080)
PORT=3000

# Kimlik doğrulama — boş bırakılırsa auth devre dışı (yalnızca local geliştirme)
AUTH_USER=example_user
AUTH_PASS=change_this_password

# Ortam modu
NODE_ENV=development
