00_admin/versions/
09_draft/backups/

# Senaryo ham metni (telif koruması)
01_story/source/raw_script.txt

# OS dosyaları
.DS_Store
Thumbs.db
desktop.ini

# Log dosyaları
*.log
npm-debug.log*

# Node modules (kullanılmıyor ama güvenlik için)
node_modules/

# Geçici dosyalar
*.tmp
*.temp
